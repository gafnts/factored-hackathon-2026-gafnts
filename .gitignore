# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

# Tool caches and test reports
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Notebooks: commit the .ipynb, never the checkpoints
.ipynb_checkpoints/

# Terraform: lock files and *.backend.tfbackend are committed on purpose
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# Holds your principal ARN; written by bootstrap.sh
infra/iam/iam.tfvars

# Secrets and local environment (keep API keys in .env, share the shape in .env.example)
.env
.env.*
!.env.example
# Sets AWS_PROFILE; written by bootstrap.sh
.envrc

# Hackathon material (organizer-provided; never committed)
/data/
/docs/hackathon/

# Editors and OS: share the workspace settings, keep the rest personal
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.claude/settings.local.json
.DS_Store
