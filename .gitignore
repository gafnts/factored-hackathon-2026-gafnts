# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

# Node, wherever an install lands
node_modules/

# Tool caches and test reports
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Terraform: lock files and *.backend.tfbackend are committed on purpose
.terraform/
# Child modules take their root's lock; the validate hook writes one per module
infra/modules/*/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# Your principal ARN and the OIDC subject CI trusts (written by scripts/bootstrap.sh)
infra/iam/iam.tfvars

# Secrets and local environment
.env
.env.*
!.env.example
# Sets AWS_PROFILE (written by scripts/bootstrap.sh)
.envrc

# Hackathon material (organizer-provided)
/data/
/docs/hackathon/

# Dataset extracts stay out of the public repo wherever they land (SEC-03)
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.duckdb
*.duckdb.wal
*.sqlite
*.db
!tests/fixtures/**

# Editors and OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.claude/settings.local.json
.DS_Store
